# 1. Прямой пуш в main запрещён — только через ветку и PR
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "⛔ Прямой пуш в main запрещён. Создайте ветку и откройте PR." >&2
    exit 1
  fi
done

# 2. Проверки тех частей, что изменились относительно main
if git rev-parse --verify -q origin/main >/dev/null; then
  changed=$(git diff --name-only origin/main...HEAD)
else
  changed=$(printf "frontend/\nbackend/api/\nbackend/ml-service/\n")
fi

targets=""
echo "$changed" | grep -q '^frontend/' && targets="$targets frontend"
for service in api ml-service; do
  echo "$changed" | grep -q "^backend/$service/" && targets="$targets backend/$service"
done

[ -z "$targets" ] && exit 0

echo ""
echo "⏳ Перед пушем запускаются тесты:$targets"
echo "   Обычно это занимает до минуты — не прерывайте."
echo ""

fail() {
  echo "" >&2
  echo "✖ $1 — пуш отменён. Исправьте и повторите." >&2
  exit 1
}

for target in $targets; do
  if [ "$target" = "frontend" ]; then
    echo "▶ frontend: проверка типов"
    (cd frontend && npm run --silent typecheck) || fail "frontend: ошибки типов"
    echo "▶ frontend: тесты"
    (cd frontend && npm run --silent test:run) || fail "frontend: тесты упали"
  else
    echo "▶ $target: тесты"
    sh scripts/pytest.sh "$target" || fail "$target: тесты упали"
  fi
done

echo ""
echo "✔ Все проверки пройдены, пушим."
